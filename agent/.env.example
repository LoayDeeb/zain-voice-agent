# LiveKit credentials (from https://cloud.livekit.io)
LIVEKIT_URL=wss://your-app.livekit.cloud
LIVEKIT_API_KEY=your-api-key
LIVEKIT_API_SECRET=your-api-secret

# ElevenLabs (from https://elevenlabs.io/app/settings/api-keys)
ELEVEN_API_KEY=your-elevenlabs-api-key

# Deepgram for STT (from https://console.deepgram.com)
DEEPGRAM_API_KEY=your-deepgram-api-key

# OpenAI (required by livekit.plugins.openai.LLM)
OPENAI_API_KEY=your-openai-api-key

# MCP tools server. For your current backend, use streamable-http transport.
MCP_SERVER_URL=https://agenticbuilder-zain.onrender.com/rpc/balance
MCP_SERVER_TRANSPORT=streamable-http
MCP_SERVER_AUTH_TOKEN=
MCP_SERVER_AUTH_HEADER=Authorization
MCP_SERVER_AUTH_SCHEME=Bearer

# Your Agent API
AGENT_API_URL=https://agenticbuilder.onrender.com/api/agent/invoke
AGENT_API_KEY=your-agent-api-key
AGENT_ID=14e9ebf0-ae34-4b21-8760-b0e3fe87275d
